# Server Config
PORT=5000
JWT_SECRET=your_jwt_secret_key

# Database Config (Supabase Session Pooler)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Paystack Payment Gateway (Ghana)
PAYSTACK_SECRET_KEY=sk_test_xxxxxx

# Stripe Payment (Optional)
STRIPE_SECRET_KEY=sk_test_xxxxxx

# Resend Transactional Email API
RESEND_API_KEY=re_xxxxxx
ADMIN_EMAIL=admin@seveedesigns.com

# Frontend URL (for CORS) - comma-separated for multiple origins
# Primary: your custom domain via Cloudflare
# Fallback: Vercel preview deployments
CLIENT_URL=https://seveedesigns.com,https://sevee-designs.vercel.app

# Gemini AI (Optional - for blog generation)
GEMINI_API_KEY=your_gemini_api_key
